# Copia este archivo como .env  →  cp .env.example .env
# y rellena con TUS datos. El .env NUNCA se sube a git ni se comparte.

# Correo con el que inicias sesión en capital.com
CAPITAL_IDENTIFIER=tu-correo@ejemplo.com

# Contraseña que definiste AL CREAR LA API KEY (no es la de tu cuenta).
# capital.com pide una "Custom password" propia para la key.
CAPITAL_API_PASSWORD=pon-aqui-el-password-de-la-api-key

# La API key (genera una NUEVA de demo en Settings -> API integrations)
CAPITAL_API_KEY=pon-aqui-tu-api-key-de-demo

# Entorno: demo (dinero ficticio) o live (dinero real).
# Se queda en demo a propósito. Para live tendrías que cambiarlo tú y además
# poner CAPITAL_ALLOW_LIVE=1 — el código bloquea live por seguridad.
CAPITAL_ENV=demo
CAPITAL_ALLOW_LIVE=0
